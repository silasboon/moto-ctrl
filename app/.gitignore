node_modules/
.expo/
dist/
web-build/

# --- Xcode ---
ios/build/
ios/Pods/
# Machine-local: overrides NODE_BINARY for Xcode's script phases. RN's own
# .xcode.env says this file "is not versioned" — committing it pins every
# build (including CI) to one machine's node path.
ios/.xcode.env.local
# Per-user window/breakpoint/scheme state Xcode rewrites constantly.
**/xcuserdata/
# The .xcworkspace is a `pod install` artifact rather than source: it is
# rewritten on every pod install, and any checkout has to run pod install
# anyway because ios/Pods/ is ignored. (The "!contents.xcworkspacedata"
# exception that used to sit here never took effect — git cannot re-include
# a file inside an excluded directory.)
*.xcworkspace

# --- Android ---
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
# Native CMake/ninja output for the New Architecture codegen. Regenerated by
# any Gradle build; ~100MB.
android/app/.cxx/
# Machine-local SDK/NDK paths.
android/local.properties

# --- Signing material ---
# debug.keystore is React Native's shared, publicly-known debug key and is
# deliberately committed so debug builds are reproducible. Anything else
# matching these is a real release credential and must never be.
*.keystore
!debug.keystore
*.jks
*.p12
*.mobileprovision

# Packaged builds. Normally under an ignored build/ dir, but easy to leave
# lying around at the repo root when testing an upload.
*.apk
*.aab
*.ipa

# --- Metro / testing / misc ---
.metro-health-check*
coverage/
*.log
.DS_Store
