<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Moto Ctrl</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- Set explicitly rather than left as $(PRODUCT_NAME): the Xcode target
	     is still called MotoCtrl, and that name would otherwise
	     surface wherever iOS falls back to CFBundleName (Settings, the
	     storage list, permission prompts). -->
	<key>CFBundleName</key>
	<string>Moto Ctrl</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- US export-compliance declaration, answered here rather than in the
	     App Store Connect dialog so TestFlight/CI uploads don't stop to ask
	     on every build.

	     Basis, as of this commit: the app implements no confidentiality
	     cryptography at all. Its only crypto is Ed25519 (RFC 8032) for
	     signing the board's challenge nonce — a digital signature, which
	     conceals nothing — and SHA-512 (FIPS 180-4) to verify a downloaded
	     firmware bundle. Actual encryption comes from the OS: HTTPS via
	     NSURLSession for the two firmware-update requests (this app's only
	     network access), and BLE Secure Connections in the radio stack. Neither
	     is implemented by this app.

	     REVISIT THIS if app code ever encrypts anything for confidentiality
	     — a stored or exported config, a payload — or if the phone-as-key
	     handshake stops relying on BLE's own encryption and does its own.
	     Either change makes this declaration wrong. It covers the iOS binary
	     only; the firmware's cheat-code hashing is out of scope. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>MOTO-CTRL connects to your bike's control board over Bluetooth to control lights, signals, and the immobilizer.</string>
	<!-- Lets the app reconnect to a paired board and unlock the immobilizer
	     while backgrounded or suspended, not just while open on screen --
	     src/ble/BoardSession.ts's watcher connects directly to the
	     already-known peripheral ID (no background scan involved, so
	     CoreBluetooth's background-scan restrictions don't apply here), and
	     the restoreStateIdentifier / restoreStateFunction passed to
	     BleManager in src/ble/bleManager.ts let the app pick that watch back
	     up if iOS relaunches it for a BLE event after fully terminating it.
	     Neither works without this capability declared. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
	</array>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Location is required to manage unlocking the bike </string>
	<key>RCTNewArchEnabled</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
